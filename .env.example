# Copie ce fichier en .env et remplis-le. Ne le commite jamais.
# Le mot de passe doit etre un MOT DE PASSE POUR APPLICATION genere sur
# https://account.apple.com/account/manage -> Securite -> Mots de passe pour application
ICLOUD_EMAIL=prenom.nom@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_DISPLAY_NAME=Prenom Nom
